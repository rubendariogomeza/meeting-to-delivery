# Copy to .env and fill only what you need. The demo works with none of these.

# Optional: narrative report through an OpenAI-compatible endpoint.
# Tasks, owners and dates stay deterministic; the model only rewrites prose.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000

# Optional: real Jira writes. Only used with --apply.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
