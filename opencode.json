{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "compaction": {
    "auto": true,
    "keep": { "tokens": 8000 },
    "buffer": "20%"
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "compaction": {
      "model": "opencode/claude-haiku-5-5"
    }
  }
}
